#!/usr/bin/env bash
set -euo pipefail

step() { printf "\033[36m▸ %s\033[0m\n" "$1"; }
fail() { printf "\033[31m✗ %s\033[0m\n" "$1" >&2; exit 1; }

step "Checking Node version"
if ! command -v node >/dev/null; then
  fail "Node is not installed. Install Node 22.x LTS (see .nvmrc) via nvm/fnm/volta."
fi
required_major=$(tr -d 'v' < .nvmrc | cut -d. -f1)
current_major=$(node -p 'process.versions.node.split(".")[0]')
if [ "$current_major" != "$required_major" ]; then
  fail "Node v${current_major} detected; kontexta requires v${required_major}.x. Run 'nvm use' / 'fnm use' / 'volta pin node@${required_major}'."
fi

step "Enabling corepack + pinned pnpm"
pnpm_version=$(node -p "require('./package.json').packageManager.split('@')[1]")
if ! command -v corepack >/dev/null; then
  fail "corepack is missing. Reinstall Node or run: npm install -g corepack"
fi
corepack enable >/dev/null
corepack prepare "pnpm@${pnpm_version}" --activate >/dev/null

step "Probing C/C++ toolchain (needed for better-sqlite3 fallback build)"
if ! command -v cc >/dev/null && ! command -v gcc >/dev/null && ! command -v clang >/dev/null; then
  case "$(uname -s)" in
    Darwin) fail "No C compiler found. Run: xcode-select --install" ;;
    Linux)  fail "No C compiler found. Install: 'sudo apt install build-essential python3' (Debian) or 'sudo dnf install gcc-c++ make python3' (Fedora)" ;;
    *)      fail "No C compiler found. Install one for your platform." ;;
  esac
fi

step "Installing workspace dependencies (pnpm install --frozen-lockfile)"
pnpm install --frozen-lockfile

step "Building kxta-core (apps import from packages/core/dist/)"
pnpm -C packages/core build

printf "\n\033[32m✓ Bootstrap complete.\033[0m\n"
printf "  Next: \033[1mpnpm dev\033[0m       Turbopack dev server on :3000\n"
printf "        \033[1mpnpm dev:lite\033[0m  webpack, low-memory alternative\n"
printf "        \033[1mpnpm test\033[0m       run vitest across the workspace\n"
